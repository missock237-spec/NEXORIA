// NEXORIA — Schéma de données : Comptes, Sessions, Personnages
// Principe : ACCOUNT ≠ CHARACTER. Un personnage appartient à un compte.
// Le serveur est autoritaire : stats/village/position générés côté serveur uniquement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./db/nexoria.db"
}

model Account {
  id             String      @id @default(cuid())
  email          String      @unique
  passwordHash   String
  recoveryKey    String
  createdAt      DateTime    @default(now())
  lastLoginAt    DateTime?
  characters     Character[]
  sessions       Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Character {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name            String   @unique
  race            String
  class           String
  appearanceJson  String // JSON validé côté serveur
  equipmentJson   String // JSON généré côté serveur
  statsJson       String // JSON généré côté serveur
  skillsJson      String // JSON généré côté serveur
  startingVillage String
  spawnPoint      String
  positionJson    String // {x,y,z} position de départ
  level           Int      @default(1)
  xp              Int      @default(0)
  gold            Int      @default(0)
  questsJson      String   @default("{}")
  titlesJson      String   @default("[]") // titres gagnés (arènes, boss)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  arenaProfile    ArenaProfile?
  arenaMatches    ArenaMatch[]
  supremeProgress SupremeProgress[]
  supremeEncounters SupremeEncounter[]

  @@index([accountId])
}

// ── ARÈNES ── Profil de classement (Elo) d'un personnage
model ArenaProfile {
  id           String   @id @default(cuid())
  characterId  String   @unique
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  rating       Int      @default(1000)
  wins         Int      @default(0)
  losses       Int      @default(0)
  streak       Int      @default(0)
  bestStreak   Int      @default(0)
  milestonesJson String @default("[]") // paliers de récompenses déjà accordés
  updatedAt    DateTime @updatedAt
}

// ── ARÈNES ── Un duel (matchmaking → résolution serveur)
model ArenaMatch {
  id             String   @id @default(cuid())
  characterId    String
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  arenaId        String
  opponentName   String
  opponentRace   String
  opponentClass  String
  opponentRating Int
  format         String   // '1v1' | '2v2' | '3v3' (format d'affiche de l'arène)
  training       Boolean  @default(false) // duel sous le niveau recommandé
  status         String   @default("pending") // pending | resolved | expired
  seed           Int      // graine déterministe du combat (côté client pour les visuals)
  resolved       String?  // 'win' | 'loss'
  ratingDelta    Int?
  durationSec    Int?
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?

  @@index([characterId])
  @@index([status])
}

// ── SUPRÊMES ── Progression d'un personnage contre un boss mondial
model SupremeProgress {
  id            String   @id @default(cuid())
  characterId   String
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  supremeId     String
  attempts      Int      @default(0)
  defeated      Boolean  @default(false)
  firstDefeatAt DateTime?
  rewardsJson   String   @default("[]")
  updatedAt     DateTime @updatedAt

  @@unique([characterId, supremeId])
  @@index([characterId])
}

// ── SUPRÊMES ── Une tentative de boss mondial (phases validées serveur)
model SupremeEncounter {
  id           String   @id @default(cuid())
  characterId  String
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  supremeId    String
  bossHp       Int      // PV totaux du boss pour cette tentative (calculés serveur)
  phasesPassed Int      @default(0) // nombre de phases validées dans l'ordre
  status       String   @default("pending") // pending | victory | defeat | expired
  seed         Int
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  @@index([characterId])
  @@index([status])
}


// ═══════════════════════════════════════════════════════════════
// MONDE PERSISTANT — Vertical Slice « Province de Solmère »
// Le serveur de simulation (world-sim) est l'autorité exclusive
// sur ces tables. Le client ne propose jamais d'état critique.
// ═══════════════════════════════════════════════════════════════

// ── ÉTAT GLOBAL du monde (une ligne, id fixe) ──
model WorldState {
  id           String   @id @default("solmere")
  timeOfDay    Float    @default(28800) // secondes du jour en jeu (0..86400)
  dayCount     Int      @default(1)
  prosperity   Float    @default(100)   // prospérité du village (0..200)
  weather      String   @default("clair")
  simTicks     Int      @default(0)     // nombre de ticks simulés (diagnostic)
  updatedAt    DateTime @updatedAt
}

// ── PNJ PERSISTANT — mort définitive, JAMAIS de respawn ──
model Npc {
  id              String   @id // id déterministe (npc_solmere_XX)
  name            String
  race            String
  age             Int
  profession      String?  // forgeron | garde | fermier | marchand | aubergiste | apothicaire | elder
  buildingId      String?  // lieu de travail (Building.id)
  homeId          String?  // logement (Building.id)
  familyJson      String   @default("[]") // ids de la famille
  personalityJson String   @default("{}")
  x               Float
  z               Float
  homeX           Float    @default(0)
  homeZ           Float    @default(0)
  workX           Float    @default(0)
  workZ           Float    @default(0)
  hp              Int
  maxHp           Int
  level           Int      @default(1)
  faction         String   @default("village")
  lifeState       String   @default("ALIVE") // ALIVE | INJURED | DEAD
  memoryJson      String   @default("[]")    // mémoire Gen3ia (événements vécus)
  isGuard         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lifeState])
}

// ── MORT DÉFINITIVE d'un PNJ — enregistrement irréversible ──
model NpcDeath {
  id        String   @id @default(cuid())
  npcId     String
  npcName   String
  killer    String   // 'monster:xxx' | 'player:characterId' | 'world'
  cause     String
  dayCount  Int
  timeOfDay Float
  createdAt DateTime @default(now())

  @@index([npcId])
}

// ── BÂTIMENT destructible / reconstructible (vraie géométrie 3D côté client) ──
model Building {
  id               String   @id
  type             String   // forge | maison | auberge | marche | garde | tour | mur
  label            String
  x                Float
  z                Float
  rotY             Float    @default(0)
  ownerId          String?  // npcId ou null (= bien communal)
  hp               Int
  maxHp            Int
  state            String   @default("INTACT") // INTACT|DAMAGED|HEAVILY_DAMAGED|DESTROYED|RUINS|RECONSTRUCTION|RESTORED
  economicFunction String   @default("none")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([state])
}

// ── PROJET DE RECONSTRUCTION — matériaux déposés, progression visible 3D ──
model ConstructionProject {
  id             String   @id @default(cuid())
  buildingId     String   @unique
  requiredBois   Int
  requiredPierre Int
  requiredFer    Int
  depositedBois  Int      @default(0)
  depositedPierre Int     @default(0)
  depositedFer   Int      @default(0)
  progress       Float    @default(0) // 0..100
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── ÉVÉNEMENT MONDIAL persistant ──
model WorldEvent {
  id               String    @id @default(cuid())
  type             String    // INVASION | MIGRATION | RECONSTRUCTION_AIDE | ...
  title            String
  description      String
  zone             String
  status           String    @default("ACTIVE") // ACTIVE | RESOLVED | CONCLUDED
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  consequencesJson String    @default("[]")
  participantsJson String    @default("[]")

  @@index([status])
}

// ── ÉTAT PERSISTANT D'UN DONJON (portes détruites restent détruites) ──
model DungeonState {
  id            String    @id @default(cuid())
  dungeonId     String
  doorHp        Int       @default(120)
  doorState     String    @default("INTACT") // INTACT | DAMAGED | DESTROYED
  bossAlive     Boolean   @default(true)
  bossRespawnAt DateTime?
  bossKillCount Int       @default(0)
  switchesJson  String    @default("[]")
  chestsJson    String    @default("[]")
  updatedAt     DateTime  @updatedAt

  @@unique([dungeonId])
}

// ── ÉTAT DE PROVINCE d'un personnage — serveur-autoritaire ──
model ProvinceState {
  id              String   @id @default(cuid())
  characterId     String   @unique
  x               Float
  z               Float
  hp              Int
  mp              Int
  level           Int      @default(1)
  xp              Int      @default(0)
  gold            Int      @default(0)
  inventoryJson   String   @default("{}") // {bois,pierre,fer,potion} — JAMAIS édité par le client
  questsJson      String   @default("[]")
  discoveriesJson String   @default("[]")
  deaths          Int      @default(0)
  kills           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
